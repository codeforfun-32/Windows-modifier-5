import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, WxIcon } from "controls.slint";

// kind: see WxIcon in controls.slint
export struct WxItem {
    label: string,
    kind: int,
    temp: string,
    sub: string,
}

component WxCard inherits Rectangle {
    in property <string> label;
    in property <int> kind: 2;
    in property <string> temp;
    in property <string> sub;

    border-radius: 18px;
    background: Theme.card;

    Text {
        x: 0px;
        y: 10px;
        width: parent.width;
        height: 18px;
        text: root.label;
        color: Theme.text-dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    WxIcon {
        x: (parent.width - 30px) / 2;
        y: parent.height / 2 - 20px;
        width: 30px;
        height: 30px;
        kind: root.kind;
    }
    Text {
        x: 0px;
        y: parent.height - 52px;
        width: parent.width;
        height: 22px;
        text: root.temp;
        color: Theme.text;
        font-size: 15px;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Text {
        x: 0px;
        y: parent.height - 30px;
        width: parent.width;
        height: 18px;
        text: root.sub;
        color: Theme.text-dim;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component WeatherPage inherits Rectangle {
    in property <bool> ready: false;
    in property <string> city: "";
    in property <string> temp: "";
    in property <string> desc: "";
    in property <string> hilo: "";
    in property <string> humidity: "";
    in property <string> wind: "";
    in property <string> rain: "";
    in property <string> sunset: "";
    in property <int> kind: 2;
    in property <[WxItem]> hours: [];
    in property <[WxItem]> days: [];
    callback refresh();

    // 0 = hourly, 1 = 7 days
    property <int> mode: 0;
    property <length> lw: 250px;

    if !root.ready : Text {
        width: parent.width;
        height: parent.height;
        text: "Finding the weather for your location...";
        color: Theme.text-dim;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.ready : Rectangle {
        width: parent.width;
        height: parent.height;

        // ---- left: now ----
        Icon {
            x: 2px;
            y: 3px;
            width: 16px;
            height: 16px;
            d: Icons.map-pin;
            tint: Theme.text-dim;
        }
        Text {
            x: 24px;
            y: 0px;
            width: root.lw - 30px;
            height: 22px;
            text: root.city;
            color: Theme.text-dim;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            x: 0px;
            y: 24px;
            width: 150px;
            height: 70px;
            text: root.temp;
            color: Theme.text;
            font-size: 60px;
            font-weight: 800;
            vertical-alignment: center;
        }
        WxIcon {
            x: 150px;
            y: 38px;
            width: 46px;
            height: 46px;
            kind: root.kind;
        }
        Text {
            x: 0px;
            y: 98px;
            width: root.lw;
            height: 22px;
            text: root.desc;
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            x: 0px;
            y: 120px;
            width: root.lw;
            height: 18px;
            text: root.hilo;
            color: Theme.text-dim;
            font-size: 12px;
            vertical-alignment: center;
        }

        Icon {
            x: 0px;
            y: 150px;
            width: 16px;
            height: 16px;
            d: Icons.droplet;
            tint: Theme.text-dim;
        }
        Text {
            x: 20px;
            y: 148px;
            width: 50px;
            height: 20px;
            text: root.humidity;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
        Icon {
            x: 76px;
            y: 150px;
            width: 16px;
            height: 16px;
            d: Icons.wind;
            tint: Theme.text-dim;
        }
        Text {
            x: 96px;
            y: 148px;
            width: 70px;
            height: 20px;
            text: root.wind;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
        Icon {
            x: 172px;
            y: 150px;
            width: 16px;
            height: 16px;
            d: Icons.rain;
            tint: Theme.text-dim;
        }
        Text {
            x: 192px;
            y: 148px;
            width: 56px;
            height: 20px;
            text: root.rain;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }
        Icon {
            x: 0px;
            y: 176px;
            width: 16px;
            height: 16px;
            d: Icons.sunset;
            tint: Theme.text-dim;
        }
        Text {
            x: 20px;
            y: 174px;
            width: 120px;
            height: 20px;
            text: root.sunset;
            color: Theme.text;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: 0px;
            y: parent.height - 22px;
            width: 160px;
            height: 20px;
            text: "Forecast: Open-Meteo";
            color: Theme.text-dim;
            font-size: 11px;
            vertical-alignment: center;
        }
        Rectangle {
            x: root.lw - 30px;
            y: parent.height - 26px;
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: rf.has-hover ? Theme.chip-active : transparent;

            Icon {
                x: 5px;
                y: 5px;
                width: 16px;
                height: 16px;
                d: Icons.refresh;
                tint: Theme.text-dim;
            }
            rf := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.refresh(); }
            }
        }

        // divider
        Rectangle {
            x: root.lw + 12px;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.border;
        }

        // ---- right: forecast ----
        Text {
            x: root.lw + 32px;
            y: 0px;
            width: 200px;
            height: 30px;
            text: root.mode == 0 ? "Next 24 hours" : "Next 7 days";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Rectangle {
            x: parent.width - 156px;
            y: 0px;
            width: 156px;
            height: 30px;
            border-radius: 15px;
            background: Theme.card;

            Rectangle {
                x: root.mode == 0 ? 2px : 78px;
                y: 2px;
                width: 76px;
                height: 26px;
                border-radius: 13px;
                background: Theme.fill;
                animate x { duration: 160ms; easing: ease-out; }
            }
            Text {
                x: 2px;
                y: 2px;
                width: 76px;
                height: 26px;
                text: "Hourly";
                color: root.mode == 0 ? Theme.on-fill : Theme.text-dim;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                x: 78px;
                y: 2px;
                width: 76px;
                height: 26px;
                text: "7 days";
                color: root.mode == 1 ? Theme.on-fill : Theme.text-dim;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                x: 0px;
                width: 78px;
                mouse-cursor: pointer;
                clicked => { root.mode = 0; }
            }
            TouchArea {
                x: 78px;
                width: 78px;
                mouse-cursor: pointer;
                clicked => { root.mode = 1; }
            }
        }

        Rectangle {
            x: root.lw + 32px;
            y: 42px;
            width: parent.width - root.lw - 32px;
            height: parent.height - 42px;
            clip: true;

            Flickable {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                interactive: true;
                content-width: (root.mode == 0 ? root.hours.length : root.days.length) * 72px;
                content-height: self.height;

                for h[i] in root.hours : WxCard {
                    visible: root.mode == 0;
                    x: i * 72px;
                    y: 0px;
                    width: 64px;
                    height: parent.height;
                    label: h.label;
                    kind: h.kind;
                    temp: h.temp;
                    sub: h.sub;
                }
                for d[i] in root.days : WxCard {
                    visible: root.mode == 1;
                    x: i * 72px;
                    y: 0px;
                    width: 64px;
                    height: parent.height;
                    label: d.label;
                    kind: d.kind;
                    temp: d.temp;
                    sub: d.sub;
                }
            }
        }
    }
}
