import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, HSlider } from "controls.slint";
import { Scroller } from "scroller.slint";

// Icons used by the quick settings page.
export global QIcons {
    out property <string> wifi: "M 2 9 A 14 14 0 0 1 22 9 M 5 12.5 A 9.5 9.5 0 0 1 19 12.5 M 8.5 16 A 5 5 0 0 1 15.5 16 M 12 19.5 L 12 19.6";
    out property <string> bluetooth: "M 7 7 L 17 17 L 12 22 L 12 2 L 17 7 L 7 17";
    out property <string> airplane: "M 12 2 L 14 9 L 22 14 L 22 16 L 14 13.5 L 13 19 L 16 21 L 16 22 L 12 21 L 8 22 L 8 21 L 11 19 L 10 13.5 L 2 16 L 2 14 L 10 9 Z";
    out property <string> access: "M 10 4 A 2 2 0 1 0 14 4 A 2 2 0 1 0 10 4 M 5 8 L 19 8 M 12 8 L 12 14 M 12 14 L 8 21 M 12 14 L 16 21";
    out property <string> cast: "M 3 8 L 3 5 L 21 5 L 21 19 L 14 19 M 3 12 A 7 7 0 0 1 10 19 M 3 16 A 3 3 0 0 1 6 19";
    out property <string> speaker: "M 4 9 L 8 9 L 13 5 L 13 19 L 8 15 L 4 15 Z M 16 9 A 4 4 0 0 1 16 15 M 18.5 6.5 A 8 8 0 0 1 18.5 17.5";
    out property <string> hotspot: "M 12 11 L 12 11.1 M 8.5 8.5 A 5 5 0 0 0 8.5 15.5 M 15.5 8.5 A 5 5 0 0 1 15.5 15.5 M 5.5 5.5 A 9 9 0 0 0 5.5 18.5 M 18.5 5.5 A 9 9 0 0 1 18.5 18.5 M 12 12 L 12 21";
    out property <string> camera: "M 3 7 L 17 7 L 17 17 L 3 17 Z M 17 11 L 21 8 L 21 16 L 17 13";
    out property <string> shield: "M 12 3 L 19 6 L 19 12 A 9 9 0 0 1 12 21 A 9 9 0 0 1 5 12 L 5 6 Z";
}

// State shared with Rust (src/quick/mod.rs).
export global QuickState {
    in-out property <bool> wifi-on: false;
    in-out property <bool> bt-on: false;
    in-out property <bool> airplane-on: false;
    in-out property <bool> muted: false;
    in-out property <float> volume: 0.5;
    in-out property <float> brightness: 0.5;
    // false on PCs without a built-in screen (desktop computers)
    in-out property <bool> brightness-ok: false;

    callback set-wifi(bool);
    callback set-bluetooth(bool);
    callback set-airplane(bool);
    callback toggle-mute();
    callback set-volume(float);
    callback set-brightness(float);
    callback open-setting(string);
}

struct QTile {
    label: string,
    icon: string,
    uri: string,
}

component Tile inherits Rectangle {
    in property <string> d;
    in property <string> label;
    in property <string> sub: "";
    in property <bool> on: false;
    in property <length> tile-h: 56px;
    callback clicked();

    height: root.tile-h;
    border-radius: 16px;
    background: root.on ? Theme.accent.with-alpha(0.2) : (ta.has-hover ? Theme.card-hi : Theme.card);
    border-width: 1px;
    border-color: root.on ? Theme.accent.with-alpha(0.5) : transparent;
    animate background { duration: 120ms; }

    Rectangle {
        x: 12px;
        y: (parent.height - 32px) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: root.on ? Theme.accent : Theme.chip-active;

        Icon {
            x: 7px;
            y: 7px;
            width: 18px;
            height: 18px;
            d: root.d;
            tint: root.on ? Theme.on-accent : Theme.text;
        }
    }
    Text {
        x: 54px;
        y: root.sub == "" ? 0px : 9px;
        width: parent.width - 62px;
        height: root.sub == "" ? parent.height : 20px;
        text: root.label;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.sub != "" : Text {
        x: 54px;
        y: 28px;
        width: parent.width - 62px;
        height: 16px;
        text: root.sub;
        color: Theme.text-dim;
        font-size: 11px;
        overflow: elide;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component QuickSettings inherits Rectangle {
    property <length> tw: (root.width - 20px) / 3;
    // y where the "other settings" tiles start
    property <length> rest-y: QuickState.brightness-ok ? 238px : 184px;

    property <[QTile]> tiles: [
        { label: "Energy saver", icon: Icons.battery, uri: "ms-settings:batterysaver" },
        { label: "Accessibility", icon: QIcons.access, uri: "ms-settings:easeofaccess" },
        { label: "Cast", icon: QIcons.cast, uri: "ms-settings-connectabledevices:devicediscovery" },
        { label: "Hotspot", icon: QIcons.hotspot, uri: "ms-settings:network-mobilehotspot" },
        { label: "Nearby sharing", icon: Icons.link, uri: "ms-settings:crossdevice" },
        { label: "VPN", icon: QIcons.shield, uri: "ms-settings:network-vpn" },
        { label: "Camera", icon: QIcons.camera, uri: "ms-settings:camera" },
        { label: "Display", icon: Icons.gpu, uri: "ms-settings:display" },
        { label: "Sound", icon: QIcons.speaker, uri: "ms-settings:sound" },
        { label: "Power", icon: Icons.battery, uri: "ms-settings:powersleep" },
        { label: "Network", icon: Icons.globe, uri: "ms-settings:network" },
        { label: "Updates", icon: Icons.down, uri: "ms-settings:windowsupdate" },
        { label: "All settings", icon: Icons.sliders, uri: "ms-settings:" },
    ];

    Scroller {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        content-height: root.rest-y + 5 * 54px;

        // row 1: the three real switches
        Tile {
            x: 0px;
            y: 0px;
            width: root.tw;
            d: QIcons.wifi;
            label: "Wi-Fi";
            sub: QuickState.wifi-on ? "On" : "Off";
            on: QuickState.wifi-on;
            clicked => { QuickState.set-wifi(!QuickState.wifi-on); QuickState.wifi-on = !QuickState.wifi-on; }
        }
        Tile {
            x: root.tw + 10px;
            y: 0px;
            width: root.tw;
            d: QIcons.bluetooth;
            label: "Bluetooth";
            sub: QuickState.bt-on ? "On" : "Off";
            on: QuickState.bt-on;
            clicked => { QuickState.set-bluetooth(!QuickState.bt-on); QuickState.bt-on = !QuickState.bt-on; }
        }
        Tile {
            x: 2 * (root.tw + 10px);
            y: 0px;
            width: root.tw;
            d: QIcons.airplane;
            label: "Airplane";
            sub: QuickState.airplane-on ? "On" : "Off";
            on: QuickState.airplane-on;
            clicked => { QuickState.set-airplane(!QuickState.airplane-on); QuickState.airplane-on = !QuickState.airplane-on; }
        }

        // row 2: mute, night light, focus
        Tile {
            x: 0px;
            y: 64px;
            width: root.tw;
            d: QuickState.muted ? Icons.volume-off : QIcons.speaker;
            label: "Mute";
            sub: QuickState.muted ? "On" : "Off";
            on: QuickState.muted;
            clicked => { QuickState.toggle-mute(); QuickState.muted = !QuickState.muted; }
        }
        Tile {
            x: root.tw + 10px;
            y: 64px;
            width: root.tw;
            d: Icons.moon;
            label: "Night light";
            sub: "Open settings";
            clicked => { QuickState.open-setting("ms-settings:nightlight"); }
        }
        Tile {
            x: 2 * (root.tw + 10px);
            y: 64px;
            width: root.tw;
            d: Icons.bell-off;
            label: "Focus";
            sub: "Open settings";
            clicked => { QuickState.open-setting("ms-settings:quietmomentshome"); }
        }

        // sliders
        if QuickState.brightness-ok : HSlider {
            x: 0px;
            y: 128px;
            width: parent.width;
            d: Icons.sun;
            label: "Brightness";
            value <=> QuickState.brightness;
            edited(v) => { QuickState.set-brightness(v); }
        }
        HSlider {
            x: 0px;
            y: QuickState.brightness-ok ? 184px : 128px;
            width: parent.width;
            d: QIcons.speaker;
            label: "Volume";
            value <=> QuickState.volume;
            edited(v) => { QuickState.set-volume(v); }
        }

        // everything else opens the matching Windows settings page
        for t[i] in root.tiles : Tile {
            x: Math.mod(i, 3) * (root.tw + 10px);
            y: root.rest-y + Math.floor(i / 3) * 54px;
            width: root.tw;
            tile-h: 46px;
            d: t.icon;
            label: t.label;
            clicked => { QuickState.open-setting(t.uri); }
        }
    }
}
