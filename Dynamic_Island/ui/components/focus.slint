import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, RoundBtn } from "controls.slint";
import { Scroller } from "scroller.slint";

export struct TaskItem {
    text: string,
    done: bool,
}

component Stepper inherits Rectangle {
    in property <string> label;
    in property <string> value;
    callback minus();
    callback plus();

    Text {
        x: 14px;
        y: 0px;
        width: 70px;
        height: parent.height;
        text: root.label;
        color: Theme.text-dim;
        font-size: 13px;
        font-weight: 700;
        vertical-alignment: center;
    }
    RoundBtn {
        x: parent.width - 176px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        d: Icons.minus;
        glyph: 14px;
        clicked => { root.minus(); }
    }
    Text {
        x: parent.width - 142px;
        y: 0px;
        width: 80px;
        height: parent.height;
        text: root.value;
        color: Theme.text;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    RoundBtn {
        x: parent.width - 44px;
        y: (parent.height - 30px) / 2;
        width: 30px;
        height: 30px;
        d: Icons.plus;
        glyph: 14px;
        clicked => { root.plus(); }
    }
}

export component FocusPage inherits Rectangle {
    // 0 focus, 1 break
    in property <int> mode: 0;
    in property <string> time-text: "25:00";
    // 0..1 of the session that is already over
    in property <float> frac: 0;
    in property <bool> running: false;
    in property <float> focus-min: 25;
    in property <float> break-min: 5;
    in property <[TaskItem]> tasks: [];
    in property <int> tasks-done: 0;

    callback set-mode(int);
    callback toggle();
    callback reset();
    callback adjust(int, int);
    callback task-add(string);
    callback task-toggle(int);
    callback task-remove(int);
    callback input-focus(bool);

    property <length> lw: Math.min(root.width * 0.44, 330px);
    property <length> rx: root.lw + 30px;
    property <length> rw: root.width - root.rx;

    // ---- left: timer ----
    Rectangle {
        x: 0px;
        y: 0px;
        width: 176px;
        height: 38px;
        border-radius: 19px;
        background: Theme.card;

        Rectangle {
            x: root.mode == 0 ? 3px : 88px;
            y: 3px;
            width: 85px;
            height: 32px;
            border-radius: 16px;
            background: Theme.fill;
            animate x { duration: 180ms; easing: ease-out; }
        }
        Text {
            x: 3px;
            y: 3px;
            width: 85px;
            height: 32px;
            text: "Focus";
            color: root.mode == 0 ? Theme.on-fill : Theme.text-dim;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            x: 88px;
            y: 3px;
            width: 85px;
            height: 32px;
            text: "Break";
            color: root.mode == 1 ? Theme.on-fill : Theme.text-dim;
            font-size: 13px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            x: 0px;
            width: 88px;
            mouse-cursor: pointer;
            clicked => { root.set-mode(0); }
        }
        TouchArea {
            x: 88px;
            width: 88px;
            mouse-cursor: pointer;
            clicked => { root.set-mode(1); }
        }
    }

    Text {
        x: 0px;
        y: 48px;
        width: root.lw - 120px;
        height: 70px;
        text: root.time-text;
        color: Theme.text;
        font-size: 56px;
        font-weight: 800;
        vertical-alignment: center;
    }
    RoundBtn {
        x: root.lw - 112px;
        y: 64px;
        width: 40px;
        height: 40px;
        d: Icons.reset;
        glyph: 16px;
        clicked => { root.reset(); }
    }
    RoundBtn {
        x: root.lw - 62px;
        y: 60px;
        width: 48px;
        height: 48px;
        solid: true;
        d: root.running ? Icons.pause : Icons.play;
        glyph: 20px;
        clicked => { root.toggle(); }
    }

    Rectangle {
        x: 0px;
        y: 124px;
        width: root.lw;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;

        Rectangle {
            x: 0px;
            width: parent.width * root.frac;
            height: parent.height;
            border-radius: 2px;
            background: Theme.fill;
        }
    }

    Rectangle {
        x: 0px;
        y: 142px;
        width: root.lw;
        height: Math.min(parent.height - 142px, 104px);
        border-radius: 16px;
        background: Theme.card;

        Stepper {
            x: 0px;
            y: 6px;
            width: parent.width;
            height: 44px;
            label: "Focus";
            value: "\{Math.round(root.focus-min)} min";
            minus => { root.adjust(0, -1); }
            plus => { root.adjust(0, 1); }
        }
        Stepper {
            x: 0px;
            y: 52px;
            width: parent.width;
            height: 44px;
            label: "Break";
            value: "\{Math.round(root.break-min)} min";
            minus => { root.adjust(1, -1); }
            plus => { root.adjust(1, 1); }
        }
    }

    // divider
    Rectangle {
        x: root.lw + 14px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }

    // ---- right: tasks ----
    Text {
        x: root.rx;
        y: 0px;
        width: 80px;
        height: 26px;
        text: "Tasks";
        color: Theme.text;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.tasks.length > 0 : Text {
        x: root.rx + 62px;
        y: 0px;
        width: 120px;
        height: 26px;
        text: "\{root.tasks-done}/\{root.tasks.length} done";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }

    if root.tasks.length == 0 : Rectangle {
        x: root.rx;
        y: 30px;
        width: root.rw;
        height: parent.height - 84px;

        Icon {
            x: (parent.width - 28px) / 2;
            y: parent.height / 2 - 34px;
            width: 28px;
            height: 28px;
            d: Icons.check;
            tint: Theme.text-dim;
        }
        Text {
            x: 0px;
            y: parent.height / 2 + 2px;
            width: parent.width;
            height: 22px;
            text: "Add what you want to get done";
            color: Theme.text-dim;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Scroller {
        x: root.rx;
        y: 32px;
        width: root.rw;
        height: parent.height - 86px;
        content-height: root.tasks.length * 44px;

        for t[i] in root.tasks : Rectangle {
            x: 0px;
            y: i * 44px;
            width: parent.width;
            height: 40px;
            border-radius: 14px;
            background: Theme.card;

            Rectangle {
                x: 10px;
                y: 8px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: t.done ? Theme.accent : transparent;
                border-width: 2px;
                border-color: t.done ? Theme.accent : Theme.text-dim;

                if t.done : Icon {
                    x: 4px;
                    y: 4px;
                    width: 14px;
                    height: 14px;
                    d: Icons.check;
                    tint: Theme.on-accent;
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.task-toggle(i); }
                }
            }
            Text {
                x: 46px;
                y: 0px;
                width: parent.width - 86px;
                height: parent.height;
                text: t.text;
                color: t.done ? Theme.text-dim : Theme.text;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 34px;
                y: 8px;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: rm.has-hover ? Theme.chip-active : transparent;

                Icon {
                    x: 5px;
                    y: 5px;
                    width: 14px;
                    height: 14px;
                    d: Icons.close;
                    tint: Theme.text-dim;
                }
                rm := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.task-remove(i); }
                }
            }
        }
    }

    // ---- add a task ----
    Rectangle {
        x: root.rx;
        y: parent.height - 44px;
        width: root.rw - 50px;
        height: 40px;
        border-radius: 20px;
        background: Theme.card;

        if ti.text == "" : Text {
            x: 18px;
            y: 0px;
            width: parent.width - 36px;
            height: parent.height;
            text: "Add a task and press Enter";
            color: Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
        ti := TextInput {
            x: 18px;
            y: 11px;
            width: parent.width - 36px;
            height: 20px;
            font-size: 13px;
            color: Theme.text;
            single-line: true;
            accepted => {
                if (self.text != "") {
                    root.task-add(self.text);
                    self.text = "";
                }
            }
            changed has-focus => { root.input-focus(self.has-focus); }
        }
    }
    RoundBtn {
        x: parent.width - 42px;
        y: parent.height - 44px;
        width: 40px;
        height: 40px;
        d: Icons.plus;
        glyph: 18px;
        clicked => {
            if (ti.text != "") {
                root.task-add(ti.text);
                ti.text = "";
            }
        }
    }
}
