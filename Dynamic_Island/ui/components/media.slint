// Music: the compact player on the Home tab, the full Music tab and the player picker.
import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, RoundBtn, Seek, Chip } from "controls.slint";
import { Scroller } from "scroller.slint";

export struct SourceItem {
    key: string,
    label: string,
    active: bool,
}

// Compact player (Home tab, left card).
export component PlayerCard inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <bool> playing;
    in property <bool> has-media;
    in property <float> progress;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "--:--";
    in property <image> album-art;
    in property <color> tint: #222222;
    in property <bool> tint-on: true;
    in property <bool> show-art: true;
    in property <bool> show-progress: true;
    in property <int> progress-style: 0;
    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    callback title-tapped();

    background: Theme.card;
    border-radius: 18px;
    clip: true;

    if root.has-media && root.tint-on : Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.tint;
        opacity: 0.16;
    }

    Rectangle {
        x: 16px;
        y: 16px;
        width: 58px;
        height: 58px;
        border-radius: 14px;
        background: Theme.chip;
        clip: true;

        if root.has-media && root.show-art : Image {
            width: parent.width;
            height: parent.height;
            source: root.album-art;
            image-fit: cover;
        }
        if !root.has-media || !root.show-art : Icon {
            x: (parent.width - 26px) / 2;
            y: (parent.height - 26px) / 2;
            width: 26px;
            height: 26px;
            d: Icons.music;
            tint: Theme.text-dim;
        }
    }

    Text {
        x: 88px;
        y: 18px;
        width: parent.width - 104px;
        height: 24px;
        text: root.has-media ? root.track-title : "Not playing";
        color: (tt.has-hover && root.has-media) ? Theme.accent : Theme.text;
        font-size: 15px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: 88px;
        y: 42px;
        width: parent.width - 104px;
        height: 20px;
        text: root.has-media ? root.track-artist : "Play something to see it here";
        color: Theme.text-dim;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: center;
    }
    tt := TouchArea {
        x: 88px;
        y: 18px;
        width: parent.width - 104px;
        height: 24px;
        enabled: root.has-media;
        mouse-cursor: pointer;
        clicked => { root.title-tapped(); }
    }

    if root.show-progress : Seek {
        x: 16px;
        y: parent.height - 106px;
        width: parent.width - 32px;
        value: root.progress;
        style: root.progress-style;
        seek(f) => { root.seek(f); }
    }
    if root.show-progress : Text {
        x: 16px;
        y: parent.height - 88px;
        width: 70px;
        height: 16px;
        text: root.pos-text;
        color: Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.show-progress : Text {
        x: parent.width - 86px;
        y: parent.height - 88px;
        width: 70px;
        height: 16px;
        text: root.dur-text;
        color: Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    RoundBtn {
        x: parent.width / 2 - 82px;
        y: parent.height - 64px;
        width: 40px;
        height: 40px;
        d: Icons.prev;
        glyph: 16px;
        clicked => { root.prev(); }
    }
    RoundBtn {
        x: parent.width / 2 - 26px;
        y: parent.height - 70px;
        width: 52px;
        height: 52px;
        solid: true;
        d: root.playing ? Icons.pause : Icons.play;
        glyph: 22px;
        clicked => { root.toggle(); }
    }
    RoundBtn {
        x: parent.width / 2 + 42px;
        y: parent.height - 64px;
        width: 40px;
        height: 40px;
        d: Icons.next;
        glyph: 16px;
        clicked => { root.next(); }
    }
}

// Full Music tab.
export component MusicPage inherits Rectangle {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> source-name;
    in property <bool> playing;
    in property <bool> has-media;
    in property <float> progress;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "--:--";
    in property <[float]> viz;
    in property <image> album-art;
    in property <color> tint: #222222;
    in property <bool> tint-on: true;
    in property <bool> show-art: true;
    in property <bool> show-progress: true;
    in property <int> progress-style: 0;
    in property <int> viz-style: 0;
    in property <bool> viz-on: true;
    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    callback source-tapped();
    callback title-tapped();

    property <length> lw: Math.min(root.width * 0.5, 400px);

    // ---- left: now playing ----
    Rectangle {
        x: 0px;
        y: 4px;
        width: 80px;
        height: 80px;
        border-radius: 16px;
        background: Theme.chip;
        clip: true;

        if root.has-media && root.show-art : Image {
            width: parent.width;
            height: parent.height;
            source: root.album-art;
            image-fit: cover;
        }
        if !root.has-media || !root.show-art : Icon {
            x: (parent.width - 34px) / 2;
            y: (parent.height - 34px) / 2;
            width: 34px;
            height: 34px;
            d: Icons.music;
            tint: Theme.text;
        }
    }
    Text {
        x: 96px;
        y: 10px;
        width: root.lw - 96px;
        height: 28px;
        text: root.has-media ? root.track-title : "Not playing";
        color: (tt.has-hover && root.has-media) ? Theme.accent : Theme.text;
        font-size: 18px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: 96px;
        y: 40px;
        width: root.lw - 96px;
        height: 22px;
        text: root.has-media ? root.track-artist : "Choose something you love";
        color: Theme.text-dim;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: center;
    }
    tt := TouchArea {
        x: 96px;
        y: 10px;
        width: root.lw - 96px;
        height: 28px;
        enabled: root.has-media;
        mouse-cursor: pointer;
        clicked => { root.title-tapped(); }
    }

    if root.show-progress : Seek {
        x: 0px;
        y: 102px;
        width: root.lw;
        value: root.progress;
        style: root.progress-style;
        knob: true;
        seek(f) => { root.seek(f); }
    }
    if root.show-progress : Text {
        x: 0px;
        y: 122px;
        width: 80px;
        height: 16px;
        text: root.pos-text;
        color: Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.show-progress : Text {
        x: root.lw - 80px;
        y: 122px;
        width: 80px;
        height: 16px;
        text: root.dur-text;
        color: Theme.text-dim;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    RoundBtn {
        x: root.lw / 2 - 86px;
        y: 148px;
        width: 44px;
        height: 44px;
        d: Icons.prev;
        glyph: 18px;
        clicked => { root.prev(); }
    }
    RoundBtn {
        x: root.lw / 2 - 28px;
        y: 144px;
        width: 56px;
        height: 56px;
        solid: true;
        d: root.playing ? Icons.pause : Icons.play;
        glyph: 24px;
        clicked => { root.toggle(); }
    }
    RoundBtn {
        x: root.lw / 2 + 42px;
        y: 148px;
        width: 44px;
        height: 44px;
        d: Icons.next;
        glyph: 18px;
        clicked => { root.next(); }
    }

    // player picker pill
    Rectangle {
        x: 0px;
        y: parent.height - 36px;
        width: Math.min(220px, root.lw);
        height: 32px;
        border-radius: 16px;
        background: sp.has-hover ? Theme.chip-active : Theme.chip;
        animate background { duration: 120ms; }

        Icon {
            x: 10px;
            y: 7px;
            width: 18px;
            height: 18px;
            d: Icons.headphones;
            tint: Theme.accent;
        }
        Text {
            x: 36px;
            y: 0px;
            width: parent.width - 62px;
            height: parent.height;
            text: root.source-name == "" ? "No player" : root.source-name;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
        Icon {
            x: parent.width - 24px;
            y: 9px;
            width: 14px;
            height: 14px;
            d: Icons.chev-down;
            tint: Theme.text-dim;
        }
        sp := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.source-tapped(); }
        }
    }

    // ---- right: listening room ----
    Rectangle {
        x: root.lw + 16px;
        y: 0px;
        width: parent.width - root.lw - 16px;
        height: parent.height;
        border-radius: 20px;
        background: Theme.card;
        clip: true;

        if root.has-media && root.tint-on : Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.tint;
            opacity: 0.2;
        }

        if !(root.playing && root.viz-on) : Rectangle {
            width: parent.width;
            height: parent.height;

            Icon {
                x: (parent.width - 30px) / 2;
                y: parent.height / 2 - 62px;
                width: 30px;
                height: 30px;
                d: Icons.music;
                tint: Theme.text;
            }
            Text {
                x: 10px;
                y: parent.height / 2 - 22px;
                width: parent.width - 20px;
                height: 28px;
                text: "Your listening room";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Text {
                x: 14px;
                y: parent.height / 2 + 10px;
                width: parent.width - 28px;
                height: 40px;
                text: root.has-media ? "Paused" : "Play a track in your music app to begin.";
                color: Theme.text-dim;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        if root.playing && root.viz-on : Rectangle {
            width: parent.width;
            height: parent.height;

            for b[i] in root.viz : Rectangle {
                property <length> bw: Math.min(18px, (parent.width - 80px) / 9 - 6px);
                x: (parent.width - (9 * (self.bw + 6px) - 6px)) / 2 + i * (self.bw + 6px);
                width: self.bw;
                height: Math.max(8px, b * (parent.height - 90px));
                y: parent.height - 52px - self.height;
                border-radius: root.viz-style == 0 ? 3px : self.bw / 2;
                background: Theme.accent;
                animate height { duration: 90ms; }
            }
            Text {
                x: 12px;
                y: parent.height - 40px;
                width: parent.width - 24px;
                height: 22px;
                text: root.source-name == "" ? "Now playing" : "Now playing on " + root.source-name;
                color: Theme.text-dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Choose which player the island controls.
export component SourcePicker inherits Rectangle {
    in property <[SourceItem]> items;
    callback picked(string);
    callback back();

    background: Theme.card;
    border-radius: 18px;

    Text {
        x: 18px;
        y: 12px;
        width: parent.width - 110px;
        height: 24px;
        text: "Control which player?";
        color: Theme.text;
        font-size: 14px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Chip {
        x: parent.width - 78px;
        y: 12px;
        width: 62px;
        height: 24px;
        text: "Back";
        clicked => { root.back(); }
    }

    Scroller {
        x: 14px;
        y: 46px;
        width: parent.width - 28px;
        height: parent.height - 58px;
        content-height: root.items.length * 36px;

        for item[i] in root.items : Rectangle {
            x: 0px;
            y: i * 36px;
            width: parent.width;
            height: 32px;
            border-radius: 10px;
            background: (item.active || row.has-hover) ? Theme.chip-active : Theme.chip;
            animate background { duration: 120ms; }

            Text {
                x: 12px;
                y: 0px;
                width: parent.width - 40px;
                height: parent.height;
                text: item.label;
                color: Theme.text;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 20px;
                y: 12px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
                opacity: item.active ? 1 : 0;
            }
            row := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(item.key); }
            }
        }
    }
}
