import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";

// Draws one SVG path icon (24x24 grid).
export component Icon inherits Rectangle {
    in property <string> d: "";
    in property <color> tint: Theme.text;
    width: 18px;
    height: 18px;

    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.d;
        stroke: root.tint;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// Round icon button used in the tab row.
export component IconTab inherits Rectangle {
    in property <string> d: "";
    in property <bool> active: false;
    in property <int> badge: 0;
    callback clicked();

    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: root.active ? Theme.chip-active : (ta.has-hover ? Theme.chip : transparent);
    animate background { duration: 140ms; }

    Icon {
        x: (parent.width - 18px) / 2;
        y: (parent.height - 18px) / 2;
        d: root.d;
        tint: root.active ? Theme.text : Theme.text-dim;
    }

    if root.badge > 0 : Rectangle {
        x: parent.width - 10px;
        y: 2px;
        width: 8px;
        height: 8px;
        border-radius: 4px;
        background: Theme.accent;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A page that fades and slides in when it becomes active.
// Give it `width: parent.width; height: parent.height;` where you use it.
export component Page inherits Rectangle {
    in property <bool> active: false;

    y: root.active ? 0px : 8px;
    opacity: root.active ? 1 : 0;
    visible: self.opacity > 0.01;
    animate y { duration: 240ms; easing: ease-out; }
    animate opacity { duration: 180ms; }
}

// Small text pill.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    width: 64px;
    height: 26px;
    border-radius: 13px;
    background: root.active ? Theme.fill : (ta.has-hover ? Theme.chip-active : Theme.chip);
    animate background { duration: 120ms; }

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.on-fill : Theme.text;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Rounded button with an optional icon and a label.
export component Btn inherits Rectangle {
    in property <string> text: "";
    in property <string> d: "";
    in property <bool> primary: false;
    in property <color> tint: Theme.text;
    callback clicked();

    height: 40px;
    border-radius: 13px;
    background: root.primary ? (ta.has-hover ? Theme.accent.brighter(0.2) : Theme.accent)
        : (ta.has-hover ? Theme.card-hi : Theme.card);
    animate background { duration: 120ms; }

    property <length> content-w: (root.d != "" ? 26px : 0px) + lbl.preferred-width;
    property <color> ink: root.primary ? Theme.on-accent : root.tint;

    Icon {
        visible: root.d != "";
        x: (root.width - root.content-w) / 2;
        y: (root.height - 18px) / 2;
        d: root.d;
        tint: root.ink;
    }
    lbl := Text {
        x: (root.width - root.content-w) / 2 + (root.d != "" ? 26px : 0px);
        y: 0px;
        width: self.preferred-width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Round icon-only button.
export component RoundBtn inherits Rectangle {
    in property <string> d: "";
    in property <bool> solid: false;
    in property <length> glyph: 18px;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: self.width / 2;
    background: root.solid ? (ta.has-hover ? Theme.fill.darker(0.1) : Theme.fill)
        : (ta.has-hover ? Theme.chip-active : Theme.chip);
    animate background { duration: 120ms; }

    Icon {
        x: (parent.width - root.glyph) / 2;
        y: (parent.height - root.glyph) / 2;
        width: root.glyph;
        height: root.glyph;
        d: root.d;
        tint: root.solid ? Theme.on-fill : Theme.text;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// On / off switch.
export component Toggle inherits Rectangle {
    in property <bool> on: false;
    callback toggled(bool);

    width: 44px;
    height: 26px;
    border-radius: 13px;
    background: root.on ? Theme.accent : Theme.chip-active;
    animate background { duration: 140ms; }

    Rectangle {
        x: root.on ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: root.on ? Theme.on-accent : Theme.text;
        animate x { duration: 140ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// Round progress ring (value 0..1).
export component Ring inherits Rectangle {
    in property <float> value: 0;
    in property <color> tint: Theme.accent;
    in property <float> thick: 2.5;

    width: 20px;
    height: 20px;

    property <float> size: root.width / 1px;
    property <float> r: (root.size - root.thick) / 2;
    property <float> c: root.size / 2;
    property <float> v: Math.clamp(root.value, 0, 0.9999);
    property <string> arc: "M \{root.c} \{root.c - root.r} A \{root.r} \{root.r} 0 \{root.v > 0.5 ? 1 : 0} 1 \{root.c + root.r * Math.sin(root.v * 360deg)} \{root.c - root.r * Math.cos(root.v * 360deg)}";

    Rectangle {
        border-radius: parent.width / 2;
        border-width: root.thick * 1px;
        border-color: Theme.track;
    }
    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.size;
        viewbox-height: root.size;
        commands: root.v > 0.01 ? root.arc : "";
        stroke: root.tint;
        stroke-width: root.thick * 1px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// Horizontal slider with an icon and a label inside (brightness, volume).
export component HSlider inherits Rectangle {
    in property <string> d: "";
    in property <string> label: "";
    in-out property <float> value: 0.5;
    callback edited(float);

    height: 46px;
    border-radius: 14px;
    background: Theme.card;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * root.value;
        height: parent.height;
        background: Theme.fill;
    }
    Icon {
        x: 16px;
        y: (parent.height - 18px) / 2;
        d: root.d;
        tint: root.value > 0.1 ? Theme.on-fill : Theme.text;
    }
    Text {
        x: 46px;
        y: 0px;
        width: 140px;
        height: parent.height;
        text: root.label;
        color: root.value > 0.3 ? Theme.on-fill : Theme.text;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 64px;
        y: 0px;
        width: 50px;
        height: parent.height;
        text: "\{Math.round(root.value * 100)}%";
        color: Theme.text-dim;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.value = Math.clamp(self.mouse-x / root.width, 0, 1);
                root.edited(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.value = Math.clamp(self.mouse-x / root.width, 0, 1);
                root.edited(root.value);
            }
        }
    }
}

// Song progress bar. style: 0 line, 1 thick, 2 line with a dot.
export component Seek inherits Rectangle {
    in property <float> value: 0;
    in property <int> style: 0;
    in property <bool> knob: false;
    callback seek(float);

    height: 16px;

    property <length> th: root.style == 1 ? 8px : 4px;

    Rectangle {
        x: 0px;
        y: (parent.height - root.th) / 2;
        width: parent.width;
        height: root.th;
        border-radius: root.th / 2;
        background: Theme.track;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - root.th) / 2;
        width: parent.width * root.value;
        height: root.th;
        border-radius: root.th / 2;
        background: Theme.fill;
    }
    if root.knob || root.style == 2 : Rectangle {
        x: Math.clamp(parent.width * root.value - 6px, 0px, parent.width - 12px);
        y: (parent.height - 12px) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.fill;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.seek(Math.clamp(self.mouse-x / root.width, 0, 1)); }
    }
}

// Weather symbol. kind: 0 sun, 1 partly cloudy, 2 cloud, 3 rain, 4 snow, 5 storm, 6 fog, 7 moon, 8 cloudy night.
export component WxIcon inherits Rectangle {
    in property <int> kind: 2;

    width: 28px;
    height: 28px;

    property <string> shape: root.kind == 0 ? Icons.sun
        : (root.kind == 1 ? Icons.partly
        : (root.kind == 3 ? Icons.rain
        : (root.kind == 4 ? Icons.snow
        : (root.kind == 5 ? Icons.storm
        : (root.kind == 6 ? Icons.fog
        : (root.kind == 7 ? Icons.moon : Icons.cloud))))));
    property <color> tone: root.kind == 0 ? #ffc83d
        : (root.kind == 1 ? #ffd46b
        : (root.kind == 3 ? #5aa9ff
        : (root.kind == 4 ? #cfe8ff
        : (root.kind == 5 ? #ffd24a
        : (root.kind == 7 ? #f3e7b0 : Theme.text)))));

    Path {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.shape;
        stroke: root.tone;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        fill: transparent;
    }
}

// A plain rounded card.
export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 16px;
}
