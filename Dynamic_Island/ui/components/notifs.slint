import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Chip } from "controls.slint";
import { Scroller } from "scroller.slint";

export struct NotifItem {
    time: string,
    app: string,
    title: string,
    body: string,
    // colour number 0..7 and the first letter of the app name
    hue: int,
    letter: string,
}

export global NotifColors {
    out property <[color]> list: [#e8445f, #f2a516, #3fa7ff, #2fc99b, #9b6bff, #ff7a3d, #35c2d6, #ff5fa8];
}

export component NotifList inherits Rectangle {
    in property <[NotifItem]> items;
    callback clear();

    if root.items.length == 0 : Text {
        width: parent.width;
        height: parent.height;
        text: "No notifications";
        color: Theme.text-dim;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Scroller {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height - 30px;
        content-height: root.items.length * 66px;

        for n[i] in root.items : Rectangle {
            x: 0px;
            y: i * 66px;
            width: parent.width;
            height: 60px;
            border-radius: 18px;
            background: Theme.card;

            Rectangle {
                x: 12px;
                y: 10px;
                width: 40px;
                height: 40px;
                border-radius: 12px;
                background: NotifColors.list[n.hue];

                Text {
                    width: parent.width;
                    height: parent.height;
                    text: n.letter;
                    color: #ffffff;
                    font-size: 18px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                x: 64px;
                y: 9px;
                width: parent.width - 150px;
                height: 22px;
                text: n.title;
                color: Theme.text;
                font-size: 14px;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: 64px;
                y: 31px;
                width: parent.width - 150px;
                height: 20px;
                text: n.body == "" ? n.app : n.body;
                color: Theme.text-dim;
                font-size: 12px;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                x: parent.width - 96px;
                y: 9px;
                width: 84px;
                height: 22px;
                text: n.time;
                color: Theme.text-dim;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    if root.items.length > 0 : Text {
        x: 0px;
        y: parent.height - 26px;
        width: parent.width - 100px;
        height: 24px;
        text: "\{root.items.length} notifications, scroll for more";
        color: Theme.text-dim;
        font-size: 12px;
        vertical-alignment: center;
    }
    if root.items.length > 0 : Chip {
        x: parent.width - 84px;
        y: parent.height - 28px;
        width: 84px;
        height: 26px;
        text: "Clear all";
        clicked => { root.clear(); }
    }
}
