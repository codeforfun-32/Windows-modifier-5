import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, Ring } from "controls.slint";
import { PlayerCard } from "media.slint";

component Meter inherits Rectangle {
    in property <string> label;
    in property <float> value: 0;
    in property <color> tint: Theme.fill;

    height: 22px;

    Text {
        x: 0px;
        y: 0px;
        width: 40px;
        height: parent.height;
        text: root.label;
        color: Theme.text-dim;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: 44px;
        y: (parent.height - 5px) / 2;
        width: parent.width - 44px - 48px;
        height: 5px;
        border-radius: 2.5px;
        background: Theme.track;

        Rectangle {
            x: 0px;
            width: parent.width * Math.clamp(root.value, 0, 1);
            height: parent.height;
            border-radius: 2.5px;
            background: root.tint;
            animate width { duration: 300ms; easing: ease-out; }
        }
    }
    Text {
        x: parent.width - 44px;
        y: 0px;
        width: 44px;
        height: parent.height;
        text: "\{Math.round(root.value * 100)}%";
        color: Theme.text;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

component ToolBtn inherits Rectangle {
    in property <string> d;
    in property <color> tint: Theme.text;
    callback clicked();

    border-radius: 16px;
    background: ta.has-hover ? Theme.card-hi : Theme.card;
    animate background { duration: 120ms; }

    Icon {
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        width: 20px;
        height: 20px;
        d: root.d;
        tint: root.tint;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component HomePage inherits Rectangle {
    // player
    in property <string> track-title;
    in property <string> track-artist;
    in property <bool> playing;
    in property <bool> has-media;
    in property <float> progress;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "--:--";
    in property <image> album-art;
    in property <color> tint: #222222;
    in property <bool> tint-on: true;
    in property <bool> show-art: true;
    in property <bool> show-progress: true;
    in property <int> progress-style: 0;
    // first connected Bluetooth device
    in property <string> bt-name: "";
    in property <int> bt-battery: -1;
    // system
    in property <float> cpu: 0;
    in property <float> ram: 0;
    in property <string> down: "--";
    in property <string> up: "--";

    callback prev();
    callback toggle();
    callback next();
    callback seek(float);
    callback title-tapped();
    // 0 calculator, 1 snip, 2 task manager, 3 quit island
    callback tool(int);

    property <length> lw: Math.min(root.width * 0.44, 330px);
    property <length> rx: root.lw + 12px;
    property <length> rw: root.width - root.rx;

    PlayerCard {
        x: 0px;
        y: 0px;
        width: root.lw;
        height: parent.height;
        track-title: root.track-title;
        track-artist: root.track-artist;
        playing: root.playing;
        has-media: root.has-media;
        progress: root.progress;
        pos-text: root.pos-text;
        dur-text: root.dur-text;
        album-art: root.album-art;
        tint: root.tint;
        tint-on: root.tint-on;
        show-art: root.show-art;
        show-progress: root.show-progress;
        progress-style: root.progress-style;
        prev => { root.prev(); }
        toggle => { root.toggle(); }
        next => { root.next(); }
        seek(f) => { root.seek(f); }
        title-tapped => { root.title-tapped(); }
    }

    // Bluetooth device
    Rectangle {
        x: root.rx;
        y: 0px;
        width: root.rw;
        height: 44px;
        border-radius: 16px;
        background: Theme.card;

        Icon {
            x: 14px;
            y: 13px;
            width: 18px;
            height: 18px;
            d: Icons.headphones;
            tint: Theme.text-dim;
        }
        Text {
            x: 44px;
            y: 0px;
            width: parent.width - 150px;
            height: parent.height;
            text: root.bt-name == "" ? "No device connected" : root.bt-name;
            color: root.bt-name == "" ? Theme.text-dim : Theme.text;
            font-size: 13px;
            font-weight: 700;
            overflow: elide;
            vertical-alignment: center;
        }
        if root.bt-name != "" && root.bt-battery >= 0 : Text {
            x: parent.width - 100px;
            y: 0px;
            width: 54px;
            height: parent.height;
            text: "\{root.bt-battery}%";
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if root.bt-name != "" && root.bt-battery >= 0 : Ring {
            x: parent.width - 36px;
            y: 12px;
            width: 20px;
            height: 20px;
            value: root.bt-battery / 100;
            tint: root.bt-battery < 20 ? Theme.danger : Theme.accent;
        }
    }

    // CPU and memory
    Rectangle {
        x: root.rx;
        y: 52px;
        width: root.rw;
        height: 72px;
        border-radius: 16px;
        background: Theme.card;

        Meter {
            x: 16px;
            y: 12px;
            width: parent.width - 32px;
            label: "CPU";
            value: root.cpu;
        }
        Meter {
            x: 16px;
            y: 38px;
            width: parent.width - 32px;
            label: "RAM";
            value: root.ram;
        }
    }

    // network
    Rectangle {
        x: root.rx;
        y: 132px;
        width: root.rw;
        height: 42px;
        border-radius: 16px;
        background: Theme.card;

        Text {
            x: 16px;
            y: 0px;
            width: 90px;
            height: parent.height;
            text: "Network";
            color: Theme.text;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Icon {
            x: parent.width - 220px;
            y: 14px;
            width: 14px;
            height: 14px;
            d: Icons.down;
            tint: Theme.text-dim;
        }
        Text {
            x: parent.width - 202px;
            y: 0px;
            width: 90px;
            height: parent.height;
            text: root.down;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Icon {
            x: parent.width - 108px;
            y: 14px;
            width: 14px;
            height: 14px;
            d: Icons.up;
            tint: Theme.text-dim;
        }
        Text {
            x: parent.width - 90px;
            y: 0px;
            width: 80px;
            height: parent.height;
            text: root.up;
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // tools
    for ic[i] in [Icons.calc, Icons.scissors, Icons.activity, Icons.power] : ToolBtn {
        x: root.rx + i * ((root.rw - 30px) / 4 + 10px);
        y: parent.height - 44px;
        width: (root.rw - 30px) / 4;
        height: 44px;
        d: ic;
        tint: i == 3 ? Theme.danger : Theme.text;
        clicked => { root.tool(i); }
    }
}
