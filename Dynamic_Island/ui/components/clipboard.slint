import { Theme } from "../styles/themes.slint";
import { Icons } from "../styles/icons.slint";
import { Icon, Chip } from "controls.slint";

// kind: 0 text, 1 link, 2 image, 3 files
export struct ClipItem {
    id: int,
    kind: int,
    title: string,
    sub: string,
    meta: string,
    age: string,
    pinned: bool,
    thumb: image,
    has-thumb: bool,
}

export component ClipboardPage inherits Rectangle {
    in property <[ClipItem]> clips: [];
    in-out property <int> filter: 0;
    callback picked(int);
    callback removed(int);
    callback pin-toggled(int);
    callback cleared();
    callback filter-changed(int);

    property <int> offset: 0;
    property <length> gap: 12px;
    property <length> cw: (root.width - 2 * root.gap) / 3;
    property <[string]> names: ["All", "Text", "Links", "Images", "Files", "Snippets"];
    property <[color]> tones: [#5b9bff, #b58cff, #3fd29b, #ffa24a];
    property <[string]> kind-names: ["Text", "Link", "Image", "Files"];
    property <[string]> kind-icons: [Icons.text, Icons.link, Icons.image, Icons.file];

    // ---- filter chips ----
    for n[i] in root.names : Chip {
        x: i * 80px;
        y: 0px;
        width: 72px;
        height: 28px;
        text: n;
        active: root.filter == i;
        clicked => {
            root.offset = 0;
            root.filter = i;
            root.filter-changed(i);
        }
    }
    Chip {
        x: parent.width - 64px;
        y: 0px;
        width: 64px;
        height: 28px;
        text: "Clear";
        clicked => { root.cleared(); }
    }

    // ---- cards ----
    Rectangle {
        x: 0px;
        y: 40px;
        width: parent.width;
        height: parent.height - 40px;
        clip: true;

        if root.clips.length == 0 : Text {
            width: parent.width;
            height: parent.height;
            text: root.filter == 0 ? "Copy something and it shows up here" : "Nothing in this group yet";
            color: Theme.text-dim;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        for c[i] in root.clips : Rectangle {
            x: (i - root.offset) * (root.cw + root.gap);
            y: 0px;
            width: root.cw;
            height: parent.height;
            border-radius: 18px;
            background: Theme.card;
            clip: true;
            animate x { duration: 260ms; easing: ease-out; }

            card-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(c.id); }
            }

            // header strip
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 32px;
                background: root.tones[c.kind].with-alpha(0.22);

                Icon {
                    x: 12px;
                    y: 7px;
                    width: 18px;
                    height: 18px;
                    d: root.kind-icons[c.kind];
                    tint: root.tones[c.kind];
                }
                Text {
                    x: 36px;
                    y: 0px;
                    width: parent.width - 110px;
                    height: parent.height;
                    text: c.pinned ? "Snippet" : root.kind-names[c.kind];
                    color: root.tones[c.kind];
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    x: parent.width - 74px;
                    y: 0px;
                    width: 62px;
                    height: parent.height;
                    text: c.age;
                    color: Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    opacity: (card-ta.has-hover || pin.has-hover || del.has-hover) ? 0 : 1;
                }
            }

            // body
            if c.kind == 0 : Text {
                x: 14px;
                y: 40px;
                width: parent.width - 28px;
                height: parent.height - 70px;
                text: c.title;
                color: Theme.text;
                font-size: 13px;
                wrap: word-wrap;
                overflow: elide;
            }
            if c.kind == 1 : Rectangle {
                x: 14px;
                y: 42px;
                width: parent.width - 28px;
                height: parent.height - 72px;

                Text {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 22px;
                    text: c.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    x: 0px;
                    y: 26px;
                    width: parent.width;
                    height: parent.height - 26px;
                    text: c.sub;
                    color: Theme.text-dim;
                    font-size: 12px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
            if c.kind == 2 : Rectangle {
                x: 0px;
                y: 32px;
                width: parent.width;
                height: parent.height - 32px - 26px;
                clip: true;
                background: Theme.chip;

                if c.has-thumb : Image {
                    width: parent.width;
                    height: parent.height;
                    source: c.thumb;
                    image-fit: cover;
                }
            }
            if c.kind == 3 : Rectangle {
                x: 14px;
                y: 44px;
                width: parent.width - 28px;
                height: parent.height - 76px;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: root.tones[c.kind].with-alpha(0.3);

                    Icon {
                        x: 11px;
                        y: 11px;
                        width: 22px;
                        height: 22px;
                        d: Icons.file;
                        tint: root.tones[c.kind];
                    }
                }
                Text {
                    x: 54px;
                    y: 0px;
                    width: parent.width - 54px;
                    height: 44px;
                    text: c.title;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 700;
                    wrap: word-wrap;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    x: 0px;
                    y: 50px;
                    width: parent.width;
                    height: parent.height - 50px;
                    text: c.sub;
                    color: Theme.text-dim;
                    font-size: 11px;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            // footer line
            Text {
                x: 14px;
                y: parent.height - 26px;
                width: parent.width - 28px;
                height: 22px;
                text: c.meta;
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }

            // buttons (show on hover)
            Rectangle {
                x: parent.width - 66px;
                y: 4px;
                width: 26px;
                height: 24px;
                border-radius: 12px;
                background: pin.has-hover ? Theme.chip-active : transparent;
                opacity: (card-ta.has-hover || pin.has-hover || del.has-hover) ? 1 : 0;
                visible: self.opacity > 0.01;

                Icon {
                    x: 4px;
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    d: Icons.star;
                    tint: c.pinned ? #ffd24a : Theme.text;
                }
                pin := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.pin-toggled(c.id); }
                }
            }
            Rectangle {
                x: parent.width - 36px;
                y: 4px;
                width: 26px;
                height: 24px;
                border-radius: 12px;
                background: del.has-hover ? Theme.chip-active : transparent;
                opacity: (card-ta.has-hover || pin.has-hover || del.has-hover) ? 1 : 0;
                visible: self.opacity > 0.01;

                Icon {
                    x: 4px;
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    d: Icons.trash;
                    tint: Theme.danger;
                }
                del := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.removed(c.id); }
                }
            }
        }

        // scroll arrows
        if root.offset > 0 : Rectangle {
            x: 4px;
            y: (parent.height - 40px) / 2;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            Icon {
                x: 11px;
                y: 11px;
                width: 18px;
                height: 18px;
                d: Icons.chev-left;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.offset = Math.max(0, root.offset - 3); }
            }
        }
        if root.offset + 3 < root.clips.length : Rectangle {
            x: parent.width - 44px;
            y: (parent.height - 40px) / 2;
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border;

            Icon {
                x: 11px;
                y: 11px;
                width: 18px;
                height: 18px;
                d: Icons.chev-right;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.offset = root.offset + 3; }
            }
        }
    }
}
